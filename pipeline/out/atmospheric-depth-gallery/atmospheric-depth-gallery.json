{
  "slug": "atmospheric-depth-gallery",
  "name": "Atmospheric Depth Gallery",
  "category": "cards-galleries",
  "isReactBits": false,
  "description": "Full-screen WebGL gallery where images float in a deep 3D stack. Wheel or touch moves the camera through the planes while the background gradient shifts per image and a glowing trail follows.",
  "contents": [
    "Full-viewport WebGL canvas with image planes stacked in depth",
    "Animated gradient background with blobs and grain",
    "Glowing ribbon trail",
    "Overlay with index, tone name, color chip and CMYK/RGB/HEX/PMS specs"
  ],
  "behavior": [
    "Wheel and touch scroll fly the camera through the planes with smoothing",
    "Planes cross-fade and background colors blend based on camera depth",
    "Pointer parallax, tilt and scale pulse driven by scroll velocity",
    "Trail grows with scroll progress",
    "Overlay labels update to the active plane"
  ],
