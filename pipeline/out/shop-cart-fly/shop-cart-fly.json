        "Product grid with cover image and add-to-cart button per product",
        "Fixed Cart button with item count badge",
        "Slide-in cart panel with item rows, quantity controls, total and checkout button"
    ],
    "behavior": [
        "Clicking add-to-cart dims other products and flies image copies in an arc to the cart button",
