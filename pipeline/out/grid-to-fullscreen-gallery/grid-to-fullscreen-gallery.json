{
    "slug": "grid-to-fullscreen-gallery",
    "name": "Grid To Fullscreen Gallery",
    "category": "cards-galleries",
    "isReactBits": false,
    "description": "Image grid where clicking a thumbnail expands it to fullscreen through a WebGL mesh transition with configurable corner activation, flip, noise, wave or circle distortion, then closes back to the grid.",
    "contents": [
        "Heading label at the top",
        "Three-column staggered grid of images, each with title and text",
        "Outlined repeated background word",
        "Fullscreen title overlay and close button"
    ],
    "behavior": [
        "Click or tap on a thumbnail starts a WebGL transition from the thumbnail rectangle to the full viewport",
        "Transition starts from the corner closest to the pointer and swaps the small texture for a large one",
        "Title and close button animate in after opening, close reverses the transition",
        "Grid collapses to a single column on small screens"
    ],
    "props": [
        { "name": "items", "type": "{image,imageLarge,title,text}[]", "default": "6 sample city items" },
        { "name": "bgColor", "type": "string", "default": "#151313" },
        { "name": "textColor", "type": "string", "default": "#a96b5a" },
        { "name": "gridTextColor", "type": "string", "default": "#444444" },
        { "name": "titleColor", "type": "string", "default": "#ffffff" },
        { "name": "decoColor", "type": "string", "default": "#191919" },
        { "name": "decoText", "type": "string", "default": "Connect" },
        { "name": "decoRows", "type": "number", "default": 5 },
        { "name": "showDeco", "type": "boolean", "default": true },
        { "name": "heading", "type": "string", "default": "Collection" },
        { "name": "duration", "type": "number", "default": 1.8 },
        { "name": "activation", "type": "string", "default": "closestCorner" },
        { "name": "transformation", "type": "string", "default": "flipX" },
