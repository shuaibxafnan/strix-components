{
    "slug": "diagonal-slideshow",
    "name": "Diagonal Slideshow",
    "category": "sliders-carousels",
    "isReactBits": false,
    "description": "Full-height slideshow where image cards glide diagonally in and out of a central slot, with scrambled-letter titles, tilt on hover and a click-to-open detail panel with a stretched backdrop.",
    "contents": [
        "Slide stack with image, vertical side label, number, title and subtitle per slide",
        "Previous and next arrow buttons",
        "Detail panel per slide with number, title, subtitle, multi-column text and a close button",
        "Dark backdrop block behind the current image"
    ],
    "behavior": [
        "Slides move along a diagonal path, the next and previous slides peek from the corners",
        "Titles and side labels scramble into place and disassemble letter by letter",
        "Current image tilts toward the pointer and scales on hover",
        "Clicking the current image opens details and expands the backdrop to fill the view",
        "Arrow keys navigate, Escape closes details, side slides are clickable",
        "GSAP loads by dynamic import and all timers, listeners and tweens are cleaned on unmount"
    ],
