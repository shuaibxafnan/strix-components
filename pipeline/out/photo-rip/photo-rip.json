{
    "slug": "photo-rip",
    "name": "Photo Rip",
    "category": "ui-elements",
    "isReactBits": false,
    "description": "Full-screen WebGL photo that the visitor tears in two by dragging down. The halves fall away with a paper-rip edge and the next photo drops in.",
    "contents": [
        "Full-viewport WebGL canvas with a gradient backdrop and a stack of photos",
        "Vignette overlay",
        "Animated hint label with arrow"
    ],
    "behavior": [
        "Dragging down on the photo tears it along a procedural jagged paper edge",
        "Releasing past the threshold rips the photo away and the next one drops in, cycling through the list",
        "Releasing early snaps the photo back",
        "Backdrop gradient tweens to the colors of each photo",
        "Hint animation appears after a delay until the first interaction",
        "Camera distance changes below the mobile breakpoint and the canvas resizes with its container"
    ],
    "props": [
        {"name": "images", "type": "{url,colorTop,colorBottom}[]", "default": "6 sample photos"},
        {"name": "ripTextureUrl", "type": "string | null", "default": null},
        {"name": "photoWidth", "type": "number", "default": 3},
        {"name": "photoHeight", "type": "number", "default": 2},
        {"name": "widthSegments", "type": "number", "default": 30},
        {"name": "heightSegments", "type": "number", "default": 50},
        {"name": "tearWidth", "type": "number", "default": 0.4},
        {"name": "ripWhiteThreshold", "type": "number", "default": 0.7},
        {"name": "ripResetThreshold", "type": "number", "default": 1.15},
        {"name": "tearSensitivity", "type": "number", "default": 2},
        {"name": "leftTearXAngle", "type": "number", "default": -0.01},
        {"name": "leftTearYAngle", "type": "number", "default": -0.1},
        {"name": "leftTearZAngle", "type": "number", "default": 0.05},
        {"name": "leftShadeAmount", "type": "number", "default": 0.15},
        {"name": "rightTearXAngle", "type": "number", "default": 0.2},
        {"name": "rightTearYAngle", "type": "number", "default": 0.1},
