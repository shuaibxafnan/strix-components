        { "name": "bgColor", "type": "string", "default": "#000000" },
        { "name": "loaderBg", "type": "string", "default": "#000000" },
        { "name": "loaderBarColor", "type": "string", "default": "#ffffff" },
        { "name": "textColor", "type": "string", "default": "#ffffff" },
        { "name": "images", "type": "string[]", "default": "12 sample image URLs" },
