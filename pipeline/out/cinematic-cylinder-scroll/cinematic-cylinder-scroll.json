{
    "slug": "cinematic-cylinder-scroll",
    "name": "Cinematic Cylinder Scroll",
    "category": "backgrounds-3d",
    "isReactBits": false,
    "description": "Full-screen WebGL cylinder textured with an image strip that rotates and flies the camera around it as the page scrolls, with timed text captions, streaking particle lines and a loader.",
    "contents": [
        "Fixed WebGL canvas with a cylinder wrapped in the images",
        "Scroll-timed caption texts with optional description",
        "Loading bar overlay and bouncing scroll hint"
    ],
    "behavior": [
        "Scroll scrubs cylinder rotation and a keyframed camera path through GSAP ScrollTrigger",
        "Captions fade in and out one after another across the scroll range",
        "Particle line strips appear while the cylinder rotates",
        "Loader fades out when all images are loaded",
        "Responsive cylinder size, camera distance and FOV by breakpoint"
    ],
    "props": [
