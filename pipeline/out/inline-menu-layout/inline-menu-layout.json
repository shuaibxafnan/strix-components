{
  "slug": "inline-menu-layout",
  "name": "Inline Menu Layout",
  "category": "navigation-menus",
  "isReactBits": false,
  "description": "Large inline typographic category menu with a cursor-following image reveal on hover. Clicking a category swaps the menu for a titled gallery of items, with a back arrow to return.",
  "contents": [
    "Inline list of category labels with item counts",
    "Hover reveal image per category",
    "Gallery per category with image, title, meta and plus button",
    "Back arrow button",
    "Custom circle cursor"
  ],
  "behavior": [
    "Hovering a label shows a cover image that follows the mouse with eased position and speed-based rotation",
    "Clicking a label animates the menu out and the category gallery in with staggered motion",
    "Back arrow reverses the transition",
    "Gallery images scale slightly when hovering the plus button",
    "Custom circle cursor trails the mouse and grows on interactive targets, shown only on fine pointers"
  ],
  "props": [
    {"name": "categories", "type": "{label,cover,items:{title,meta,image}[]}[]", "default": "12 sample categories"},
    {"name": "bgColor", "type": "string", "default": "#D5D7CE"},
    {"name": "textColor", "type": "string", "default": "#000"},
    {"name": "accentColor", "type": "string", "default": "#e63811"},
    {"name": "fontHref", "type": "string", "default": "https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=Archivo:wght@500;600&display=swap"},
    {"name": "titleFontFamily", "type": "string", "default": "\"Bodoni Moda\", \"Didot\", \"Times New Roman\", serif"},
    {"name": "bodyFontFamily", "type": "string", "default": "\"Archivo\", \"Helvetica Neue\", Arial, sans-serif"},
    {"name": "titleLetterSpacing", "type": "string", "default": "-0.02em"},
    {"name": "metaLetterSpacing", "type": "string", "default": "0.12em"},
    {"name": "menuFontSize", "type": "string", "default": "clamp(2rem,8vw,4.75rem)"},
    {"name": "contentFontSize", "type": "string", "default": "clamp(3rem,9vw,6rem)"},
    {"name": "hoverImageWidth", "type": "number", "default": 300},
    {"name": "hoverImageHeight", "type": "number", "default": 400},
