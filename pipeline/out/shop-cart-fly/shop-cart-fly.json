{
    "slug": "shop-cart-fly",
    "name": "Shop Cart Fly",
    "category": "ui-elements",
    "isReactBits": false,
    "description": "Product grid with add-to-cart buttons that fly stacked copies of the product image into a Cart button badge, plus a sliding cart panel with quantities, removal and total.",
